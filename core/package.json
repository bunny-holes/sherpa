{
  "name": "sherpa",
  "version": "0.8.5",
  "private": true,
  "description": "Sherpa CLI core: local-first macOS planning and context orchestrator",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "bun --bun vitest run --project unit",
    "test:stdio": "bun --bun vitest run --project stdio",
    "build": "bun build src/main.ts --compile --target=bun-darwin-arm64 --outfile dist/sherpa"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/google": "4.0.124",
    "@ai-sdk/openai": "4.0.122",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@modelcontextprotocol/server": "2.4.0",
    "ai": "7.0.179",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.5",
      "onFail": "download"
    }
  }
}
